# Keep generated artifacts and caches local. Markdown documentation throughout
# REACH_AISTATS is eligible for version control, including workbook reports.

# Ignore Markdown elsewhere in this subtree, overriding the global rule only for
# REACH_AISTATS documentation at any depth.
*.md
*.MD
*.markdown
!REACH_AISTATS/**/*.[mM][dD]
!REACH_AISTATS/**/*.[mM][aA][rR][kK][dD][oO][wW][nN]
VALIDATION.json
drive_upload/
*_upload/

# Generated experiment output. A single pilot run is ~1.2 MB of rows.csv/JSON/PNG and
# every new run adds another directory, so results are rebuilt rather than committed.
results/

# Cached features, encoders, and any model state
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.h5
*.pkl
*.pickle
*.joblib
cache/
checkpoints/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# Tooling and OS noise
.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.idea/
.vscode/

# Lean build cache (Mathlib binaries, ~5 GB); rebuild with `lake exe cache get && lake build`
.lake/
